[Unit]
Description=Sorveteria Spring Boot API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=sorveteria
Group=sorveteria
WorkingDirectory=/opt/sorveteria/current
EnvironmentFile=/etc/sorveteria/sorveteria.env
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=75 -jar /opt/sorveteria/current/app.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sorveteria

[Install]
WantedBy=multi-user.target
