# Copie este arquivo para .env e preencha os valores.
# O arquivo .env esta no .gitignore e NUNCA deve ser commitado.

# Banco de dados
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=

# JWT: no minimo 32 caracteres aleatorios. Gere com: openssl rand -base64 48
JWT_SECRET=
# Tempo de expiracao do token (ex.: 30m, 2h, 1d)
JWT_EXPIRATION=2h

# Front-end liberado no CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Usuario GERENTE criado automaticamente se nao houver nenhum usuario no banco
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# AWS (se o projeto usar): nunca coloque as chaves no codigo
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
